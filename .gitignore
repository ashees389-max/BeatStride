# Android — native project. NOT purely auto-generated: contains hand-written
# custom plugins/services (BeatStrideWakeLockPlugin.kt, BeatStrideTimerService.kt,
# etc.) that `npx cap sync` does not create or preserve. android/.gitignore and
# android/app/.gitignore (standard Android templates) handle excluding build
# output, local.properties, signing files, etc. — do not re-add a blanket
# android/ ignore here, it would hide those nested rules from ever applying.

# Capacitor generated web bundle
www/

# Node
node_modules/
npm-debug.log

# Signing — NEVER commit these
*.jks
*.keystore
key.properties

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
*.iml
.idea/

# Build outputs
*.apk
*.aab

# Notes — personal/scratch file, not part of the project
notes.txt